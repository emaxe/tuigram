# ── Telegram API Credentials ──────────────────────────────────────────────────
# Получить на https://my.telegram.org -> API development tools.
# Проще всего заполнить командой: tuigram init
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Data & Storage Directories ────────────────────────────────────────────────
# По умолчанию файлы лежат в пользовательских директориях ОС и НЕ внутри пакета:
#   настройки (этот файл):  ~/.config/tuigram/.env
#                           %APPDATA%\tuigram\.env                  (Windows)
#   сессия и загрузки:      ~/.local/share/tuigram/
#                           %LOCALAPPDATA%\tuigram\                 (Windows)
# Переопределить можно переменными ниже (раскомментируйте при необходимости).
# TUIGRAM_CONFIG_DIR=
# TUIGRAM_DATA_DIR=

# Устаревшая переменная: относительный путь разрешается от корня пакета.
# Оставлена для совместимости со старыми установками из клона репозитория.
# DATA_DIR=./data

# ── TUI UI Preferences ────────────────────────────────────────────────────────
# Тема интерфейса: default (тёмная), nord, light (светлая)
TUI_THEME=default

# Автоскролл к последнему сообщению при открытии чата (true/false)
AUTO_SCROLL=true

# Показывать уведомления о наборе текста (true/false)
SHOW_TYPING=true
